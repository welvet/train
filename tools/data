#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any

from _workspace import (
    WorkspaceError,
    data_dir,
    validate_workspace,
)


def write_json(path: Path, value: dict[str, Any]) -> bool:
    if path.exists():
        return False
    path.write_text(json.dumps(value, indent=2) + "\n")
    return True


def init_workspace(root: Path) -> None:
    root.mkdir(parents=True, exist_ok=True)
    created: list[str] = []

    backend = {
        "api": {"host": "127.0.0.1", "port": 8080, "url": "http://127.0.0.1:8080"},
        "arduino_server": {"host": "0.0.0.0", "port": 9000},
    }
    trains = {"trains": []}
    arduinos = {"devices": {}}
    deployment = {
        "ftp": {
            "host": "",
            "port": 21,
            "username": "",
            "remote_dir": "/train/deploy",
            "tls": False,
        },
        "health_url": "",
        "target": {
            "system": "",
            "machine": "",
            "implementation": "",
            "python": "",
            "platform": "",
            "soabi": "",
        },
    }
    secrets = {"devices": {}, "deployment": {"ftp_password": ""}}
    automations = {"version": 1, "rules": []}

    for name, value in (
        ("backend.json", backend),
        ("trains.json", trains),
        ("arduinos.json", arduinos),
        ("deployment.json", deployment),
        ("secrets.json", secrets),
        ("automations.json", automations),
    ):
        if write_json(root / name, value):
            created.append(name)

    secrets_file = root / "secrets.json"
    if secrets_file.exists():
        secrets_file.chmod(0o600)

    if created:
        print(f"Initialized {root}: {', '.join(created)}")
    else:
        print(f"Workspace already exists at {root}; nothing changed")


def main() -> None:
    parser = argparse.ArgumentParser(description="Manage the ignored railway workspace")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("init")
    subparsers.add_parser("validate")
    args = parser.parse_args()
    root = data_dir()

    try:
        if args.command == "init":
            init_workspace(root)
        else:
            validate_workspace(root)
            print(f"Workspace is valid: {root}")
    except WorkspaceError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc


if __name__ == "__main__":
    main()
