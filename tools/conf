#!/usr/bin/env python3
from __future__ import annotations

import argparse
import ftplib
import sys

from _deployment import load_deployment, pull_configuration, push_configuration
from _workspace import WorkspaceError, data_dir


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Explicitly transfer persistent configuration between this workspace and the server"
    )
    parser.add_argument("direction", choices=("pull", "push"))
    args = parser.parse_args()
    workspace = data_dir()
    try:
        config = load_deployment(workspace)
        if args.direction == "pull":
            pull_configuration(config, workspace)
            print("Pulled server configuration into the local workspace.")
        else:
            push_configuration(config, workspace)
            print("Pushed local configuration to the server.")
    except (*ftplib.all_errors, OSError, RuntimeError, WorkspaceError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc


if __name__ == "__main__":
    main()
