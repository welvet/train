#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

from _workspace import REPO_ROOT, WorkspaceError, arduino_device, arduino_secrets

FIRMWARE = REPO_ROOT / "firmware" / "TrainController"


def cpp_string(value: object) -> str:
    return json.dumps(str(value))


def generate_config(device: dict[str, Any], secrets: dict[str, str]) -> str:
    switches = device["switches"]
    readers = device["readers"]
    switch_values = switches or [{"id": "", "pin": 0, "straight": 0, "diverge": 0}]
    reader_values = readers or [
        {"id": "", "ss_pin": 0, "read_timeout_ms": 1, "removal_delay_ms": 1}
    ]

    lines = [
        "#ifndef GENERATED_CONFIG_H",
        "#define GENERATED_CONFIG_H",
        '#include "config_types.h"',
        f"constexpr char HUB_ID[] = {cpp_string(device['hub_id'])};",
        f"constexpr char BACKEND_HOST[] = {cpp_string(device['backend_host'])};",
        f"constexpr uint16_t BACKEND_PORT = {device['backend_port']};",
        f"constexpr char WIFI_SSID[] = {cpp_string(secrets['wifi_ssid'])};",
        f"constexpr char WIFI_PASSWORD[] = {cpp_string(secrets['wifi_password'])};",
        f"constexpr unsigned long SERIAL_BAUDRATE = {device['baudrate']};",
        f"constexpr unsigned long SERVO_SETTLE_MS = {device['servo_settle_ms']};",
        f"constexpr unsigned long RECONNECT_MS = {device['reconnect_ms']};",
        "constexpr bool EVENT_LOGGER_ENABLED = "
        f"{str(device.get('event_logger_enabled', False)).lower()};",
        f"constexpr int SWITCH_COUNT = {len(switches)};",
        f"constexpr int SWITCH_STORAGE_SIZE = {max(1, len(switches))};",
        "const SwitchConfig SWITCHES[SWITCH_STORAGE_SIZE] = {",
    ]
    lines.extend(
        f"  {{{cpp_string(item['id'])}, {item['pin']}, {item['straight']}, {item['diverge']}}},"
        for item in switch_values
    )
    lines.extend([
        "};",
        f"constexpr int READER_COUNT = {len(readers)};",
        f"constexpr int READER_STORAGE_SIZE = {max(1, len(readers))};",
        "const ReaderConfig READERS[READER_STORAGE_SIZE] = {",
    ])
    lines.extend(
        f"  {{{cpp_string(item['id'])}, {item['ss_pin']}, {item['read_timeout_ms']}, {item['removal_delay_ms']}}},"
        for item in reader_values
    )
    lines.extend(["};", "#endif", ""])
    return "\n".join(lines)


def prepare_sketch(device_id: str, destination: Path) -> tuple[dict[str, Any], Path]:
    device = arduino_device(device_id)
    secrets = arduino_secrets(device_id)
    sketch = destination / "TrainController"
    shutil.copytree(FIRMWARE, sketch)
    (sketch / "generated_config.h").write_text(generate_config(device, secrets))
    return device, sketch


def run(command: list[str]) -> None:
    print(f"→ {' '.join(command)}")
    subprocess.run(command, check=True)


def compile_or_upload(device_id: str, upload: bool) -> None:
    with tempfile.TemporaryDirectory(prefix="train-firmware-") as directory:
        device, sketch = prepare_sketch(device_id, Path(directory))
        compile_command = [
            "arduino-cli", "compile", "--fqbn", device["fqbn"], str(sketch)
        ]
        run(compile_command)
        if upload:
            run([
                "arduino-cli", "upload", "-p", device["port"],
                "--fqbn", device["fqbn"], str(sketch),
            ])


def monitor(device_id: str) -> None:
    device = arduino_device(device_id)
    run([
        "arduino-cli", "monitor", "-p", device["port"],
        "--config", f"baudrate={device['baudrate']}",
    ])


def main() -> None:
    parser = argparse.ArgumentParser(description="Build and operate configured Arduino devices")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("compile", "upload", "monitor"):
        subparser = subparsers.add_parser(command)
        subparser.add_argument("device_id")
    subparsers.add_parser("list")
    args = parser.parse_args()

    try:
        if args.command == "list":
            devices = read_devices()
            for device_id in sorted(devices):
                print(device_id)
        elif args.command == "compile":
            compile_or_upload(args.device_id, upload=False)
        elif args.command == "upload":
            compile_or_upload(args.device_id, upload=True)
        else:
            monitor(args.device_id)
    except (WorkspaceError, subprocess.CalledProcessError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc


def read_devices() -> dict[str, Any]:
    from _workspace import read_json

    value = read_json("arduinos.json").get("devices")
    if not isinstance(value, dict):
        raise WorkspaceError("arduinos.json: 'devices' must be an object")
    return value


if __name__ == "__main__":
    main()
