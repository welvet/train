#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import signal
import sys
import urllib.error
import urllib.request

from _workspace import WorkspaceError, backend_url

SERVER = ""


def request(method: str, path: str, body: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"{SERVER}{path}", data=data, method=method)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=5) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as exc:
        result = json.loads(exc.read())
        print(f"Error: {result.get('error', exc)}", file=sys.stderr)
        raise SystemExit(1) from exc
    except urllib.error.URLError as exc:
        print(f"Connection failed: {exc.reason}", file=sys.stderr)
        raise SystemExit(1) from exc


def train_status(args: argparse.Namespace) -> None:
    if args.speed is not None:
        result = request("POST", f"/trains/{args.name}/speed", {"speed": args.speed})
        print(f"{result['train_name']}: speed={result['speed']} ok={result['success']}")
        return
    result = request("GET", f"/trains/{args.name}")
    print(
        f"{result['train_name']}: connected={result['connected']} "
        f"speed={result['speed']} battery={result['battery_pct']}% "
        f"voltage={result['voltage']}V"
    )


def set_speed(args: argparse.Namespace) -> None:
    result = request("POST", f"/trains/{args.name}/speed", {"speed": args.speed})
    print(f"{result['train_name']}: speed={result['speed']} ok={result['success']}")


def stop_train(args: argparse.Namespace) -> None:
    result = request("POST", f"/trains/{args.name}/speed", {"speed": 0})
    print(f"{result['train_name']}: stopped ok={result['success']}")


def hub_status(args: argparse.Namespace) -> None:
    result = request("GET", f"/hubs/{args.name}")
    print(f"{result['hub_name']}: connected={result['connected']}")
    for switch in result["switches"]:
        print(f"  switch {switch['name']}: angle={switch['angle']}")
    for detector in result["detectors"]:
        train_id = detector.get("train_id") or "none"
        print(
            f"  detector {detector['name']}: "
            f"triggered={detector['triggered']} train={train_id}"
        )


def set_switch(args: argparse.Namespace) -> None:
    position = {"s": "straight", "d": "diverge"}.get(
        args.position, args.position
    )
    try:
        body: dict[str, str | int] = {"angle": int(position)}
    except ValueError:
        if position not in {"straight", "diverge"}:
            print("Position must be straight, diverge, s, d, or an angle", file=sys.stderr)
            raise SystemExit(1)
        body = {"position": position}
    result = request(
        "POST",
        f"/hubs/{args.hub}/switches/{args.switch}/position",
        body,
    )
    print(
        f"{result['hub_name']}/{result['switch_name']}: "
        f"angle={result['angle']} ok={result['ok']}"
    )


def logs(_: argparse.Namespace) -> None:
    req = urllib.request.Request(f"{SERVER}/logs")
    try:
        signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
        with urllib.request.urlopen(req, timeout=None) as response:
            for line in response:
                print(line.decode().rstrip())
    except (KeyboardInterrupt, urllib.error.URLError):
        pass


def simple_command(path: str, message: str):
    def invoke(_: argparse.Namespace) -> None:
        request("POST", path)
        print(message)

    return invoke


def main() -> None:
    parser = argparse.ArgumentParser(description="Train control CLI")
    parser.add_argument("--server", help="Override data/backend.json API URL")
    commands = parser.add_subparsers(dest="command", required=True)

    train_parser = commands.add_parser("train")
    train_parser.add_argument("name")
    train_parser.add_argument("-s", "--speed", type=int)
    train_parser.set_defaults(handler=train_status)

    go_parser = commands.add_parser("go")
    go_parser.add_argument("name")
    go_parser.add_argument("speed", type=int)
    go_parser.set_defaults(handler=set_speed)

    stop_parser = commands.add_parser("stop")
    stop_parser.add_argument("name")
    stop_parser.set_defaults(handler=stop_train)

    hub_parser = commands.add_parser("hub")
    hub_parser.add_argument("name")
    hub_parser.set_defaults(handler=hub_status)

    switch_parser = commands.add_parser("sw")
    switch_parser.add_argument("hub")
    switch_parser.add_argument("switch")
    switch_parser.add_argument("position")
    switch_parser.set_defaults(handler=set_switch)

    commands.add_parser("logs").set_defaults(handler=logs)
    commands.add_parser("halt").set_defaults(
        handler=simple_command("/halt", "Automation halted")
    )
    commands.add_parser("resume").set_defaults(
        handler=simple_command("/resume", "Automation resumed")
    )
    commands.add_parser("shutdown").set_defaults(
        handler=simple_command("/stop", "Backend stopped")
    )

    args = parser.parse_args()
    global SERVER
    try:
        SERVER = (args.server or backend_url()).rstrip("/")
    except WorkspaceError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
    args.handler(args)


if __name__ == "__main__":
    main()
