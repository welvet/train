#!/usr/bin/env python3
"""Scan for nearby LEGO Powered Up BLE hubs."""

import asyncio
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT / "backend"))

from train.ble_scan import BLE_SCAN_TIMEOUT, scan_lego_hubs


async def scan() -> None:
    print(f"Scanning for LEGO hubs ({BLE_SCAN_TIMEOUT:g}s)...")
    hubs = await scan_lego_hubs()
    for hub in hubs:
        print(f"  {hub['address']}  {hub['name'] or '(unnamed)'}")
    if not hubs:
        print("No LEGO hubs found. Make sure the hub is on (LED blinking).")


if __name__ == "__main__":
    asyncio.run(scan())
