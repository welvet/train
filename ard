#!/usr/bin/env python3
"""Arduino CLI wrapper. Reads config from arduino.json."""

import argparse
import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
CONFIG_PATH = os.path.join(ROOT, "arduino.json")


def load_config():
    with open(CONFIG_PATH) as f:
        return json.load(f)


def run(cmd):
    print(f"→ {' '.join(cmd)}")
    result = subprocess.run(cmd)
    if result.returncode != 0:
        sys.exit(result.returncode)


def cmd_compile(args, cfg):
    sketch = args.sketch or find_sketch()
    run(["arduino-cli", "compile", "--fqbn", cfg["fqbn"], sketch])


def cmd_upload(args, cfg):
    sketch = args.sketch or find_sketch()
    port = args.port or cfg["port"]
    run(["arduino-cli", "upload", "-p", port, "--fqbn", cfg["fqbn"], sketch])


def cmd_go(args, cfg):
    """Compile + upload in one step."""
    sketch = args.sketch or find_sketch()
    port = args.port or cfg["port"]
    run(["arduino-cli", "compile", "--fqbn", cfg["fqbn"], sketch])
    run(["arduino-cli", "upload", "-p", port, "--fqbn", cfg["fqbn"], sketch])


def cmd_monitor(args, cfg):
    port = args.port or cfg["port"]
    baudrate = str(args.baudrate or cfg["baudrate"])
    run(["arduino-cli", "monitor", "-p", port, "--config", f"baudrate={baudrate}"])


def cmd_boards(args, cfg):
    run(["arduino-cli", "board", "list"])


def find_sketch():
    sketches = []
    for entry in sorted(os.listdir(ROOT)):
        ino = os.path.join(ROOT, entry, f"{entry}.ino")
        if os.path.isfile(ino):
            sketches.append(os.path.join(ROOT, entry))

    if len(sketches) == 1:
        return sketches[0]
    if len(sketches) > 1:
        names = ", ".join(os.path.basename(sketch) for sketch in sketches)
        print(
            f"Multiple sketches found ({names}). Pass --sketch explicitly.",
            file=sys.stderr,
        )
        sys.exit(1)

    print("No sketch found. Pass --sketch or create one.", file=sys.stderr)
    sys.exit(1)


def main():
    cfg = load_config()

    parser = argparse.ArgumentParser(description="Arduino CLI wrapper")
    parser.add_argument("--sketch", help="Sketch directory (auto-detected if omitted)")
    parser.add_argument("--port", help=f"Serial port (default: {cfg['port']})")
    parser.add_argument("--baudrate", type=int, help=f"Baud rate (default: {cfg['baudrate']})")

    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("compile", help="Compile the sketch")
    sub.add_parser("upload", help="Upload to board")
    sub.add_parser("go", help="Compile + upload")
    sub.add_parser("monitor", help="Open serial monitor")
    sub.add_parser("boards", help="List connected boards")

    args = parser.parse_args()

    commands = {
        "compile": cmd_compile,
        "upload": cmd_upload,
        "go": cmd_go,
        "monitor": cmd_monitor,
        "boards": cmd_boards,
    }
    commands[args.command](args, cfg)


if __name__ == "__main__":
    main()
