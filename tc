#!/usr/bin/env python3
"""Train control CLI."""

import argparse
import json
import signal
import sys
import urllib.error
import urllib.request

SERVER = "http://192.168.50.80:8080"


def set_server(url):
    global SERVER
    SERVER = url


def req(method, path, body=None):
    data = json.dumps(body).encode() if body else None
    r = urllib.request.Request(f"{SERVER}{path}", data=data, method=method)
    if data:
        r.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(r, timeout=5) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        result = json.loads(e.read())
        print(f"Error: {result.get('error', e)}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Connection failed: {e.reason}", file=sys.stderr)
        sys.exit(1)


def cmd_train(args):
    if args.speed is not None:
        r = req("POST", f"/trains/{args.name}/speed", {"speed": args.speed})
        print(f"{r['train_name']}: speed={r['speed']} ok={r['success']}")
    else:
        r = req("GET", f"/trains/{args.name}")
        print(f"{r['train_name']}: connected={r['connected']} speed={r['speed']} "
              f"battery={r['battery_pct']}% voltage={r['voltage']}V")


def cmd_go(args):
    r = req("POST", f"/trains/{args.name}/speed", {"speed": args.speed})
    print(f"{r['train_name']}: speed={r['speed']} ok={r['success']}")


def cmd_stop_train(args):
    r = req("POST", f"/trains/{args.name}/speed", {"speed": 0})
    print(f"{r['train_name']}: stopped ok={r['success']}")


def cmd_hub(args):
    r = req("GET", f"/hubs/{args.name}")
    print(f"{r['hub_name']}: connected={r['connected']}")
    for sw in r["switches"]:
        print(f"  switch {sw['name']}: angle={sw['angle']}")
    for det in r["detectors"]:
        print(f"  detector {det['name']}: triggered={det['triggered']}")


def cmd_switch(args):
    angle_map = {"straight": 58, "diverge": 100, "s": 58, "d": 100}
    angle = angle_map.get(args.position)
    if angle is None:
        try:
            angle = int(args.position)
        except ValueError:
            print("Position must be: straight (s), diverge (d), or an angle number", file=sys.stderr)
            sys.exit(1)
    r = req("POST", f"/hubs/{args.hub}/switches/{args.switch}/position", {"angle": angle})
    print(f"{r['hub_name']}/{r['switch_name']}: angle={r['angle']} ok={r['ok']}")


def cmd_logs(args):
    r = urllib.request.Request(f"{SERVER}/logs")
    try:
        signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
        with urllib.request.urlopen(r, timeout=None) as resp:
            for line in resp:
                print(line.decode().rstrip())
    except (KeyboardInterrupt, urllib.error.URLError):
        pass


def cmd_stop_server(args):
    r = req("POST", "/stop")
    print(f"ok={r.get('ok')}")


def main():
    parser = argparse.ArgumentParser(description="Train control CLI")
    parser.add_argument("--server", default=SERVER, help=f"Server URL (default: {SERVER})")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("train", help="Get train info")
    p.add_argument("name", nargs="?", default="arctic_express")
    p.add_argument("-s", "--speed", type=int, help="Set speed (-100..100)")

    p = sub.add_parser("go", help="Start train")
    p.add_argument("speed", nargs="?", type=int, default=80)
    p.add_argument("-n", "--name", default="arctic_express")

    p = sub.add_parser("stop", help="Stop the train")
    p.add_argument("name", nargs="?", default="arctic_express")

    p = sub.add_parser("hub", help="Get hub info")
    p.add_argument("name", nargs="?", default="A_HUB_1")

    p = sub.add_parser("sw", help="Set switch position")
    p.add_argument("switch", help="Switch name (S1, S2)")
    p.add_argument("position", help="straight (s), diverge (d), or angle")
    p.add_argument("--hub", default="A_HUB_1")

    sub.add_parser("logs", help="Stream server logs")
    sub.add_parser("shutdown", help="Stop the server")

    args = parser.parse_args()
    set_server(args.server)

    commands = {
        "train": cmd_train,
        "go": cmd_go,
        "stop": cmd_stop_train,
        "hub": cmd_hub,
        "sw": cmd_switch,
        "logs": cmd_logs,
        "shutdown": cmd_stop_server,
    }
    commands[args.command](args)


if __name__ == "__main__":
    main()
